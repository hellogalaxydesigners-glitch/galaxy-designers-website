# =============================================================================
#  Galaxy Designers – environment settings
# =============================================================================
#  Copy the SERVER section to  server/.env
#  Copy the WEBSITE section to client/.env  (only needed if you set any of them)
#  Never commit real .env files – they contain secrets.
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER  (server/.env)
# -----------------------------------------------------------------------------

# development | production
NODE_ENV=production
PORT=8787

# Public address of the website – used for CORS and links in emails
SITE_URL=https://www.your-domain.com

# Only if the API runs on a different domain from the website (comma-separated)
# CORS_ORIGINS=https://www.your-domain.com,https://your-domain.com

# Number of proxies in front of the app (Render / Railway / Nginx / Cloudflare = 1)
TRUST_PROXY=1

# --- Database (REQUIRED in production) ---------------------------------------
# Supabase: Project → Connect → "Session pooler" connection string (URI)
# e.g. postgresql://postgres.abcdefgh:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# require (default, Supabase/most hosts) | no-verify | disable (local Postgres only)
DATABASE_SSL=require

# Any long random string – used to anonymise IP addresses before storing them
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# --- Email notifications (optional, recommended) -----------------------------
# Works with any SMTP provider: Google Workspace, Zoho Mail, Brevo, Resend, Amazon SES …
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Who receives new enquiries (comma-separated for several people)
NOTIFY_EMAIL_TO=
# Sender shown on notification emails – must be allowed by your SMTP provider
NOTIFY_EMAIL_FROM="Galaxy Designers Website <website@your-domain.com>"
# Also send a short "we received your enquiry" email to the visitor
SEND_CONFIRMATION_EMAIL=true

# --- CRM / automation webhook (optional) -------------------------------------
# Every new enquiry is POSTed here as JSON (HubSpot, Zoho, Make, Zapier, n8n …)
CRM_WEBHOOK_URL=
# Optional – adds an X-Galaxy-Signature HMAC-SHA256 header the receiver can verify
CRM_WEBHOOK_SECRET=

# --- Spam protection (optional) ----------------------------------------------
# Cloudflare Turnstile secret key (set VITE_TURNSTILE_SITE_KEY for the website too)
TURNSTILE_SECRET_KEY=

# --- Enquiry export (optional) -----------------------------------------------
# Enables GET /api/admin/enquiries?format=csv with header "Authorization: Bearer <token>"
# Use at least 24 random characters. Leave empty to disable.
ADMIN_TOKEN=


# -----------------------------------------------------------------------------
#  WEBSITE  (client/.env – read at build time)
# -----------------------------------------------------------------------------

# Public address – overrides siteConfig.url for canonical links and the sitemap
VITE_SITE_URL=https://www.your-domain.com

# Google Analytics 4 measurement ID (loads only after visitor consent)
VITE_GA_ID=

# Google Search Console verification code (content of the meta tag only)
VITE_GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile site key (public)
VITE_TURNSTILE_SITE_KEY=

# Only if the API is on a different domain, e.g. https://api.your-domain.com
VITE_API_URL=
